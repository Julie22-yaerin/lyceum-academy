# Shared
APP_ENV=development
APP_NAME=Pclick

# PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pclick

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_AUDIENCE=authenticated

# OpenAI
OPENAI_API_KEY=your-openai-key
# Dedicated paid key for AI Roles (coach, grader) — paid subscriber tiers only
# Free tier uses OPENAI_API_KEY above; paid tiers use this key
OPENAI_PAID_KEY=
OPENAI_MODEL_ANALYSIS=gpt-4o
OPENAI_MODEL_HINTS=gpt-4o-mini

# Persona Mind — GPT-4.1 multi-agent persona brain
# Get key at: https://platform.openai.com/api-keys
# Falls back to OPENAI_API_KEY if not set.
PERSONA_MIND_KEY=your-openai-key
PERSONA_MIND_MODEL=gpt-4.1

# API
API_CORS_ORIGINS=http://localhost:3000
API_ALLOW_DEV_AUTH=true

# YouTube extraction also falls back to the official YouTube Data API v3
# using GOOGLE_API_KEY (quota is per key, NOT per IP — immune to IP blocks).
# For that tier to work, enable "YouTube Data API v3" for your key's project:
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
# (free tier: 10,000 units/day; one videos.list call = 1 unit)

# Firebase (API token verification + Firestore personas)
FIREBASE_PROJECT_ID=pclick-9f190
# Path to a downloaded Firebase service account JSON key.
# Get it from: Firebase Console → Project Settings → Service Accounts → Generate new key
# Leave empty on GCP/Cloud Run (Application Default Credentials are used instead).
FIREBASE_SERVICE_ACCOUNT_PATH=

# NVIDIA NIM — DeepSeek (learning roadmap generator, see /ai/roadmap).
# Falls back to NVIDIA_API_KEY if unset.
NVIDIA_DEEPSEEK_KEY=
NVIDIA_DEEPSEEK_MODEL=deepseek-ai/deepseek-v4-flash

# NVIDIA NIM — Safety Guard (security police, SOC-16+)
# Nemotron Safety Guard 8B scans EVERY AI response before delivery.
# Falls back to NVIDIA_API_KEY if unset. Leave empty to disable.
NVIDIA_SAFETY_KEY=
NVIDIA_SAFETY_MODEL=nvidia/llama-3.1-nemotron-safety-guard-8b-v3

# NVIDIA NIM — Feedback Insights (admin Feedback dashboard AI charts)
# Clusters free-text student feedback into themes. Uses NVIDIA_API_KEY.
NVIDIA_FEEDBACK_MODEL=google/gemma-2-2b-it

# WolframAlpha (computation plugin, SOC-17) — free AppID at
# https://developer.wolframalpha.com/access. Used for exact calculation
# instead of an LLM call, and as a last-resort answer when every chat
# provider above is down or errors out. Leave empty to disable.
WOLFRAM_APP_ID=

# ── Premium AI Roles ────────────────────────────────────────────────────────
# Anthropic (Claude 3.5 Sonnet + Claude 3 Opus) — Feynman Listener + Concierge
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_CLAUDE_SONNET_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_CLAUDE_OPUS_MODEL=claude-3-opus-20240229

# OpenAI o1 — Coach (Backend Orchestrator, deep CoT batch)
# Uses OPENAI_API_KEY (free tier) or OPENAI_PAID_KEY (paid tiers) based on subscription
OPENAI_O1_MODEL=o1

# Google Gemini 1.5 Pro — Scientific Debate Partner (multimodal)
# ALL tiers use the same GOOGLE_API_KEY and gemini-1.5-pro
GOOGLE_GEMINI_PRO_MODEL=gemini-1.5-pro

# Concierge performance threshold (0.0–1.0):
# Below → foundational blocks; At or above → theoretical debates
CONCIERGE_PERFORMANCE_THRESHOLD=0.6

# Feynman Listener: max Socratic questions per turn (spec: 3)
FEYNMAN_MAX_QUESTIONS=3

# Coach batch schedule (UTC)
COACH_BATCH_HOUR=3
COACH_BATCH_MINUTE=0

# Google reCAPTCHA v3 (bot protection on login/signup) — secret key from
# https://www.google.com/recaptcha/admin. Pairs with the frontend's
# VITE_RECAPTCHA_SITE_KEY. Leave empty to disable verification (the
# login-attempt rate limit still applies on its own).
RECAPTCHA_SECRET_KEY=

# ── Cloudflare Workers AI (image generation + podcast narration) ──────────
# All three are required together: the account id is part of the REST URL,
#   POST https://api.cloudflare.com/client/v4/accounts/<id>/ai/run/<model>
# so a token on its own cannot address the endpoint. Find the account id in
# the Cloudflare dashboard URL, or under Workers & Pages -> Overview.
# Leave any of these empty and the app falls back to its local paths:
# tiny-sd on the server's CPU for images, browser speechSynthesis for audio.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGE_TOKEN=
CLOUDFLARE_TTS_TOKEN=
# Break-time short "reels". NOTE: Workers AI has NO text-to-video model —
# a reel is assembled from generated stills + narration, not an encoded video.
CLOUDFLARE_REELS_TOKEN=
# Optional model overrides. Defaults are set in app/core/config.py.
# CLOUDFLARE_IMAGE_MODEL=@cf/bytedance/stable-diffusion-xl-lightning
# CLOUDFLARE_TTS_MODEL=@cf/myshell-ai/melotts

# ── Billing / retention ───────────────────────────────────────────────────
# Free-trial length attached to the Stripe checkout session (card captured up
# front, first charge after this many days).
TRIAL_PERIOD_DAYS=4
# Stripe coupon id for the 65% save-offer shown in the cancel flow. Create it
# in Stripe -> Products -> Coupons. Leave empty and an accepted offer is
# recorded for manual follow-up instead of applied automatically.
STRIPE_RETENTION_COUPON_ID=
# Quanta credited for booking a call during the cancel flow.
RETENTION_CALL_BONUS_QUANTA=200

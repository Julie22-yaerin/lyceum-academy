# Shared
APP_ENV=development
APP_NAME=Pclick

# PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pclick

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_AUDIENCE=authenticated

# OpenAI
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL_ANALYSIS=gpt-5.5
OPENAI_MODEL_HINTS=gpt-5.5-mini

# API
API_CORS_ORIGINS=http://localhost:3000
API_ALLOW_DEV_AUTH=true

# yt-dlp cookies (optional) — fixes "Could not extract content from this
# YouTube video" when it's actually YouTube blocking this server's IP, not
# the video itself. Export cookies.txt from a logged-in browser (e.g. the
# "Get cookies.txt LOCALLY" extension) and point this at the file's path.
YTDLP_COOKIES_FILE=

# yt-dlp proxy (optional) — route YouTube extraction through a residential/
# rotating proxy if this server's own IP keeps getting rate-limited/blocked.
# Also used by youtube-transcript-api (attempt 1).
# Format: http://user:pass@host:port or socks5://host:port
YTDLP_PROXY=

# YouTube extraction also falls back to the official YouTube Data API v3
# using GOOGLE_API_KEY (quota is per key, NOT per IP — immune to IP blocks).
# For that tier to work, enable "YouTube Data API v3" for your key's project:
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
# (free tier: 10,000 units/day; one videos.list call = 1 unit)

# Firebase (API token verification)
FIREBASE_PROJECT_ID=pclick-9f190

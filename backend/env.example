# ══════════════════════════════════════════════════════════════════════════════
# Pclick Backend Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values.
# Never commit .env to git — it contains secrets.

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=Pclick

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pclick

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=

# ── Encryption (SOC-16) ───────────────────────────────────────────────────────
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'

# Primary key (current) — used for new encryptions
ENCRYPTION_KEY_PRIMARY=

# Secondary keys (for rotation) — comma-separated, used only for decryption
ENCRYPTION_KEYS_SECONDARY=

# ── OpenAI + AI Providers ─────────────────────────────────────────────────────
OPENAI_API_KEY=
CRITIQUE_OPENAI_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
OLLAMA_API_KEY=
NVIDIA_API_KEY=

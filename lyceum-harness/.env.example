# ── The Lyceum Harness — operator configuration ────────────────────────────
#
# NOTE: there is deliberately NO API key here. This harness is bring-your-own-
# key: the client's provider key arrives on each request as X-LLM-API-Key and
# is never read from the environment, never persisted, never logged.
#
# Everything below is an operational knob. All values shown are the defaults —
# the harness runs correctly with this file absent entirely.

# Logging. Guardrail rejections log at INFO because they are normal traffic;
# raise to WARNING if that is noisy in production.
LYCEUM_LOG_LEVEL=INFO

# Model defaults. Callers can override per request with X-LLM-Model.
LYCEUM_GEMINI_MODEL=gemini-2.5-flash
LYCEUM_OPENAI_MODEL=gpt-4o-mini

# Generation. Low temperature on purpose: these are explanations rendered into
# a UI, and output that churns between identical requests looks like a bug.
LYCEUM_TEMPERATURE=0.25
LYCEUM_MAX_OUTPUT_TOKENS=4096

# Resilience. max_attempts counts the FIRST call, so 3 = one try + two retries.
LYCEUM_MAX_ATTEMPTS=3
LYCEUM_RETRY_BASE_S=0.75
LYCEUM_RETRY_MAX_S=8.0
# Ceiling on a provider-supplied Retry-After, so a hostile or buggy 429 cannot
# park a client's request thread for minutes.
LYCEUM_MAX_RETRY_AFTER_S=10.0
LYCEUM_CONNECT_TIMEOUT_S=5.0
LYCEUM_READ_TIMEOUT_S=90.0

# One extra round trip to repair a schema-violating response before failing the
# request. Costs a call; converts most would-be 502s into a success.
LYCEUM_REPAIR_PASS=1

# CORS. Empty = closed (server-to-server only), which is the right default:
# calling this from a browser exposes the caller's own LLM key to end users.
# Comma-separated origins to open it, e.g. https://app.yourcompany.com
LYCEUM_CORS_ORIGINS=
